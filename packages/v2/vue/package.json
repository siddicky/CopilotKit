{
  "name": "@copilotkitnext/vue",
  "version": "1.52.0-next.8",
  "description": "Vue composables for CopilotKit",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.45",
    "@ag-ui/core": "0.0.45",
    "@copilotkitnext/core": "workspace:*",
    "@copilotkitnext/shared": "workspace:*",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@copilotkitnext/eslint-config": "workspace:*",
    "@copilotkitnext/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/index.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git",
    "directory": "packages/v2/vue"
  },
  "license": "MIT"
}
